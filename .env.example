# Names only. Set real values in Vercel (Project → Settings → Environment Variables), never in the repo.
# Server-only values must NOT be prefixed with NEXT_PUBLIC_.

# Form and buyer emails (Resend; chisokulabs.com is verified)
RESEND_API_KEY=

# Azure Database for PostgreSQL (flexible server). Example shape:
# postgres://website_app:<password>@<server>.postgres.database.azure.com:5432/chisokulabs
# TLS with certificate checks is always on; no sslmode is needed.
DATABASE_URL=

# Azure Blob Storage: the private container holding the Pack ZIP
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
PACK_CONTAINER=
PACK_BLOB_PATH=

# Razorpay (test keys start rzp_test_, live keys rzp_live_; RAZORPAY_MODE must match)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Links in emails. Leave empty on previews to use the preview's own address.
SITE_URL=

# Ops action that delivers report PDFs (scripts/ops/deliver-report.mjs). At least 32 random characters.
ADMIN_API_TOKEN=

# Google Search Console verification
GOOGLE_SITE_VERIFICATION=
